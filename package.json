{
  "name": "woxmail",
  "version": "1.0.0",
  "private": true,
  "description": "WoxMail — Private email suite with temp mail, WoxAuth, WoxCalendar, and WoxSMS",
  "workspaces": [
    "server",
    "client"
  ],
  "type": "module",
  "bin": {
    "woxmail": "./bin/woxmail.js"
  },
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "migrate": "npm run migrate --workspace=server",
    "start": "npm run start --workspace=server",
    "test:e2e": "node tests/e2e.js",
    "test:suite": "node tests/comprehensive_test_suite.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
