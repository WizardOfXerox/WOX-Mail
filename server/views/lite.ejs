<!DOCTYPE html>
<html lang="en" data-theme="dark" data-low-resource="true">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title><%= title || 'WoxMail Lite — Low Resource Mode' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: #0b0a12; color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; font-size: 14px; line-height: 1.5; }
    .lite-container { max-width: 1040px; margin: 0 auto; padding: 1rem; }
    .lite-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 0.85rem; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem; }
    .lite-badge { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.6rem; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); border-radius: 999px; font-size: 0.75rem; color: #f59e0b; font-weight: 700; }
    .lite-nav { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.5rem; margin-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .lite-nav a { padding: 0.35rem 0.75rem; border-radius: 6px; text-decoration: none; font-size: 0.8125rem; font-weight: 600; color: #94a3b8; background: rgba(255,255,255,0.04); white-space: nowrap; }
    .lite-nav a.active { background: #7c3aed; color: #ffffff; }
    .lite-nav a:hover { background: rgba(255,255,255,0.1); color: #ffffff; }
    .lite-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; margin-bottom: 1.5rem; }
    .lite-table th, .lite-table td { padding: 0.65rem 0.75rem; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.08); vertical-align: top; }
    .lite-table th { background: rgba(255,255,255,0.04); color: #94a3b8; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
    .lite-table tr.unread td { font-weight: 700; color: #ffffff; }
    .lite-table tr:hover td { background: rgba(255,255,255,0.03); }
    .lite-link { color: #8b5cf6; text-decoration: none; }
    .lite-link:hover { text-decoration: underline; }
    .lite-card { background: #141224; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem; }
    .lite-msg-header { border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.75rem; margin-bottom: 1rem; }
    .lite-msg-body { font-size: 0.9375rem; line-height: 1.6; color: #e2e8f0; word-break: break-word; }
    .lite-msg-body pre { background: #1a172e; padding: 1rem; border-radius: 6px; overflow-x: auto; font-family: monospace; font-size: 0.875rem; }
    .lite-compose { display: flex; flexDirection: column; gap: 0.75rem; }
    .lite-input, .lite-textarea { width: 100%; box-sizing: border-box; background: #1a172e; border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; padding: 0.5rem 0.75rem; color: #ffffff; font-size: 0.875rem; }
    .lite-textarea { min-height: 140px; font-family: inherit; resize: vertical; }
    .lite-alert { padding: 0.65rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.8125rem; }
    .lite-alert-success { background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.35); color: #4ade80; }
    .lite-alert-error { background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; }
    .lite-meta-bar { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: #94a3b8; margin-top: 0.5rem; }
    .btn-lite { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; border-radius: 6px; font-size: 0.8125rem; font-weight: 600; text-decoration: none; cursor: pointer; border: 1px solid transparent; }
    .btn-lite-primary { background: #7c3aed; color: #ffffff; }
    .btn-lite-primary:hover { background: #6d28d9; }
    .btn-lite-secondary { background: rgba(255,255,255,0.08); color: #f1f5f9; border-color: rgba(255,255,255,0.12); }
    .btn-lite-secondary:hover { background: rgba(255,255,255,0.14); }
  </style>
</head>
<body>
  <div class="lite-container">
    <!-- Header -->
    <header class="lite-header">
      <div style="display: flex; align-items: center; gap: 0.65rem;">
        <strong style="font-size: 1.15rem; color: #ffffff;">WoxMail Lite</strong>
        <span class="lite-badge">⚡ Low Resource Mode</span>
        <span style="font-size: 0.75rem; color: #94a3b8;">(<%= user.email %>)</span>
      </div>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <a href="/dashboard" class="btn-lite btn-lite-secondary" title="Switch to Full Rich SPA">Switch to Full SPA</a>
        <a href="/lite?folder=<%= encodeURIComponent(currentFolder) %>" class="btn-lite btn-lite-primary">Refresh</a>
        <a href="/auth/logout" class="btn-lite btn-lite-secondary" style="color: #f87171;">Logout</a>
      </div>
    </header>

    <% if (typeof alertMessage !== 'undefined' && alertMessage) { %>
      <div class="lite-alert lite-alert-success"><%= alertMessage %></div>
    <% } %>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="lite-alert lite-alert-error"><%= errorMessage %></div>
    <% } %>

    <!-- Folder Navigation -->
    <nav class="lite-nav">
      <% const navFolders = ['INBOX', 'Sent', 'Drafts', 'Archive', 'Trash', 'Spam']; %>
      <% navFolders.forEach(function(f) { %>
        <a href="/lite?folder=<%= encodeURIComponent(f) %>" class="<%= currentFolder.toUpperCase() === f.toUpperCase() ? 'active' : '' %>">
          <%= f === 'INBOX' ? 'Inbox' : f %>
        </a>
      <% }); %>
      <a href="/lite?action=compose" style="color: #4ade80; margin-left: auto;">+ Compose</a>
    </nav>

    <% if (currentAction === 'compose') { %>
      <!-- Compose Form -->
      <div class="lite-card">
        <h3 style="margin-top: 0; margin-bottom: 1rem; color: #ffffff;">Compose New Message</h3>
        <form method="POST" action="/lite/send" class="lite-compose">
          <input type="hidden" name="folder" value="<%= currentFolder %>">
          <div>
            <label style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 0.25rem;">TO (Recipient):</label>
            <input type="email" name="to" class="lite-input" required placeholder="recipient@example.com" value="<%= composeDefaults?.to || '' %>">
          </div>
          <div>
            <label style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 0.25rem;">SUBJECT:</label>
            <input type="text" name="subject" class="lite-input" required placeholder="Subject..." value="<%= composeDefaults?.subject || '' %>">
          </div>
          <div>
            <label style="font-size: 0.75rem; color: #94a3b8; display: block; margin-bottom: 0.25rem;">MESSAGE (Plain Text):</label>
            <textarea name="text" class="lite-textarea" required placeholder="Write your message here..."><%= composeDefaults?.text || '' %></textarea>
          </div>
          <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <a href="/lite?folder=<%= encodeURIComponent(currentFolder) %>" class="btn-lite btn-lite-secondary">Cancel</a>
            <button type="submit" class="btn-lite btn-lite-primary">Send Email</button>
          </div>
        </form>
      </div>

    <% } else if (selectedMessage) { %>
      <!-- Message Viewer -->
      <div class="lite-card">
        <div class="lite-msg-header">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem;">
            <h2 style="margin: 0; font-size: 1.2rem; color: #ffffff;"><%= selectedMessage.subject || '(No Subject)' %></h2>
            <div style="display: flex; gap: 0.4rem;">
              <a href="/lite?folder=<%= encodeURIComponent(currentFolder) %>" class="btn-lite btn-lite-secondary">Back to List</a>
              <a href="/lite?action=compose&replyUid=<%= selectedMessage.uid %>&folder=<%= encodeURIComponent(currentFolder) %>" class="btn-lite btn-lite-primary">Reply</a>
            </div>
          </div>
          <div style="font-size: 0.8125rem; color: #94a3b8;">
            <div><strong>From:</strong> <%= selectedMessage.from?.text || selectedMessage.from?.name || selectedMessage.from?.address || 'Unknown' %></div>
            <div><strong>To:</strong> <%= selectedMessage.to?.text || selectedMessage.to?.address || user.email %></div>
            <div><strong>Date:</strong> <%= selectedMessage.date ? new Date(selectedMessage.date).toLocaleString() : '' %></div>
          </div>
        </div>

        <div class="lite-msg-body">
          <% if (selectedMessage.text) { %>
            <pre style="white-space: pre-wrap; margin: 0;"><%= selectedMessage.text %></pre>
          <% } else if (selectedMessage.html) { %>
            <div style="background: #ffffff; color: #000000; padding: 1rem; border-radius: 6px; overflow-x: auto;">
              <%- selectedMessage.html %>
            </div>
          <% } else { %>
            <p class="text-secondary">(No text body content)</p>
          <% } %>
        </div>
      </div>

    <% } else { %>
      <!-- Messages List -->
      <% if (messages.length === 0) { %>
        <div class="lite-card" style="text-align: center; color: #94a3b8; padding: 2.5rem 1rem;">
          No messages in <%= currentFolder %>.
        </div>
      <% } else { %>
        <table class="lite-table">
          <thead>
            <tr>
              <th style="width: 25%;">From</th>
              <th style="width: 55%;">Subject &amp; Preview</th>
              <th style="width: 20%; text-align: right;">Date</th>
            </tr>
          </thead>
          <tbody>
            <% messages.forEach(function(m) { %>
              <tr class="<%= m.seen ? '' : 'unread' %>">
                <td>
                  <span style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 220px;">
                    <%= m.from?.name || m.from?.address || 'Someone' %>
                  </span>
                </td>
                <td>
                  <a href="/lite?folder=<%= encodeURIComponent(currentFolder) %>&view=<%= m.uid %>" class="lite-link" style="<%= m.seen ? '' : 'font-weight: 700;' %>">
                    <%= m.subject || '(No Subject)' %>
                  </a>
                  <% if (m.snippet) { %>
                    <span style="color: #64748b; font-size: 0.8125rem; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 500px; font-weight: 400;">
                      — <%= m.snippet %>
                    </span>
                  <% } %>
                </td>
                <td style="text-align: right; color: #94a3b8; font-size: 0.75rem; white-space: nowrap;">
                  <%= m.date ? new Date(m.date).toLocaleDateString([], { month: 'short', day: 'numeric' }) : '' %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <!-- Simple Pagination -->
        <div class="lite-meta-bar">
          <span>Showing latest <%= messages.length %> messages in <%= currentFolder %></span>
          <div style="display: flex; gap: 0.4rem;">
            <% if (page > 1) { %>
              <a href="/lite?folder=<%= encodeURIComponent(currentFolder) %>&page=<%= page - 1 %>" class="btn-lite btn-lite-secondary">&larr; Prev</a>
            <% } %>
            <% if (messages.length >= 15) { %>
              <a href="/lite?folder=<%= encodeURIComponent(currentFolder) %>&page=<%= page + 1 %>" class="btn-lite btn-lite-secondary">Next &rarr;</a>
            <% } %>
          </div>
        </div>
      <% } %>
    <% } %>

    <footer style="margin-top: 2rem; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1rem; text-align: center; font-size: 0.75rem; color: #64748b;">
      WoxMail Lite • Optimized for 2G/3G &amp; Slow Connections • Ultra-Low Bandwidth Mode
    </footer>
  </div>
</body>
</html>
