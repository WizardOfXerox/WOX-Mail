<%- include('layouts/base', { title: 'Forgot Password', body: `

<div class="auth-page">
  <div class="auth-card card">
    <div class="auth-header">
      <div class="stat-icon-wrap" style="margin: 0 auto 1rem; width: 56px; height: 56px; border-radius: 16px;">
        <svg class="stat-icon text-purple" style="width: 28px; height: 28px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
      </div>
      <h1 class="auth-title">Reset Password</h1>
      <p class="text-secondary">Enter your email to receive a reset link or use your recovery code</p>
    </div>

    <div class="auth-tabs">
      <button class="auth-tab active" onclick="showTab('email-tab', this)">Recovery Email</button>
      <button class="auth-tab" onclick="showTab('code-tab', this)">Recovery Code</button>
    </div>

    <form id="forgot-form" class="auth-form" data-tab="email-tab">
      <div class="form-group">
        <label for="forgot-email" class="form-label">Your Email Address</label>
        <input type="email" id="forgot-email" name="email" class="input mono" placeholder="username@domain.com" required>
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-full" id="forgot-btn">
        <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        <span>Send Reset Link</span>
      </button>
    </form>

    <form id="recovery-code-form" class="auth-form" style="display:none;" data-tab="code-tab">
      <div class="form-group">
        <label for="rc-email" class="form-label">Your Email Address</label>
        <input type="email" id="rc-email" class="input mono" placeholder="username@domain.com" required>
      </div>
      <div class="form-group">
        <label for="rc-code" class="form-label">Recovery Code</label>
        <input type="text" id="rc-code" class="input mono" placeholder="ABCDEF1234" required maxlength="10">
      </div>
      <div class="form-group">
        <label for="rc-password" class="form-label">New Password</label>
        <input type="password" id="rc-password" class="input" placeholder="Min 8 characters" required minlength="8">
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-full" id="rc-btn">
        <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>Reset Password</span>
      </button>
    </form>

    <div class="auth-footer">
      <a href="/login" class="text-secondary">← Back to login</a>
    </div>
  </div>
</div>

`, scripts: `
<script src="/js/auth.js"></script>
<script>
  function showTab(tabId, btn) {
    document.querySelectorAll('.auth-form').forEach(f => f.style.display = 'none');
    document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
    const form = document.querySelector('[data-tab="' + tabId + '"]');
    if (form) form.style.display = 'flex';
    btn.classList.add('active');
  }

  const rcForm = document.getElementById('recovery-code-form');
  if (rcForm) {
    rcForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('rc-btn');
      btn.disabled = true; btn.innerHTML = '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation:spin 1s linear infinite;"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg> Resetting...';
      try {
        const res = await fetch('/api/auth/recover-with-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: document.getElementById('rc-email').value.trim(),
            recoveryCode: document.getElementById('rc-code').value.trim(),
            newPassword: document.getElementById('rc-password').value,
          }),
        });
        const data = await res.json();
        if (!res.ok) return WoxToast.error(data.error);
        WoxToast.success(data.message);
        setTimeout(() => window.location.href = '/login', 1500);
      } catch { WoxToast.error('Network error'); }
      finally { btn.disabled = false; btn.innerHTML = '<span>Reset Password</span>'; }
    });
  }
</script>
`, showFooter: false }) %>

<style>
  .auth-page { min-height: calc(100vh - var(--nav-height)); display: flex; align-items: center; justify-content: center; padding: 2rem; }
  .auth-card { max-width: 440px; width: 100%; padding: 2.5rem; border-radius: var(--radius-xl); }
  .auth-header { text-align: center; margin-bottom: 1.5rem; }
  .auth-title { font-size: 1.65rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.01em; }
  .auth-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
  .form-label { font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); }
  .btn-full { width: 100%; justify-content: center; }
  .auth-footer { text-align: center; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .auth-tabs { display: flex; gap: 0; margin-bottom: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill); overflow: hidden; padding: 0.25rem; background: var(--color-bg-input); }
  .auth-tab { flex: 1; padding: 0.5rem; background: transparent; border: none; border-radius: var(--radius-pill); color: var(--color-text-secondary); cursor: pointer; font-size: 0.8125rem; font-weight: 600; transition: all var(--transition-fast); }
  .auth-tab.active { background: var(--color-primary); color: white; box-shadow: 0 0 10px var(--color-primary-glow); }
</style>

