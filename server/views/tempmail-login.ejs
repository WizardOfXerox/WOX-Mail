<%- include('layouts/base', { title: 'Temp Mail Login', body: `

<div class="auth-page">
  <div class="auth-card card">
    <div class="auth-header">
      <div class="stat-icon-wrap" style="margin: 0 auto 1rem; width: 56px; height: 56px; border-radius: 16px;">
        <svg class="stat-icon text-purple" style="width: 28px; height: 28px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h1 class="auth-title">Personal Temp Login</h1>
      <p class="text-secondary">Sign back into your password-protected temp mailbox</p>
    </div>

    <form id="temp-login-form" class="auth-form">
      <div class="form-group">
        <label for="temp-address" class="form-label">Email Address</label>
        <input type="text" id="temp-address" class="input mono" placeholder="yourname@tempdomain.com" required>
      </div>

      <div class="form-group">
        <label for="temp-password" class="form-label">Password</label>
        <input type="password" id="temp-password" class="input" placeholder="Your mailbox password" required>
      </div>

      <button type="submit" class="btn btn-primary btn-lg btn-full" id="temp-login-btn">
        <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
        <span>Sign In</span>
      </button>
    </form>

    <div class="auth-footer">
      <p class="text-secondary">Don't have a personal mailbox? <a href="/tempmail/personal" class="text-purple font-medium">Create one here</a></p>
      <p class="text-tertiary" style="margin-top:0.5rem;">Or use <a href="/tempmail">Public Instant Temp Mail</a></p>
    </div>
  </div>
</div>

`, scripts: `
<script>
  document.getElementById('temp-login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('temp-login-btn');
    const address = document.getElementById('temp-address').value.trim();
    const password = document.getElementById('temp-password').value;

    if (!address || !password) return WoxToast.error('Fill in all fields');

    btn.disabled = true;
    btn.innerHTML = 'Signing in...';

    try {
      const res = await fetch('/api/tempmail/personal/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ address, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        WoxToast.error(data.error || 'Login failed');
        return;
      }

      WoxToast.success('Welcome back!');
      setTimeout(() => window.location.href = '/tempmail/personal', 500);
    } catch {
      WoxToast.error('Network error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg> <span>Sign In</span>';
    }
  });
</script>
`, showFooter: false }) %>

<style>
  .auth-page { min-height: calc(100vh - var(--nav-height)); display: flex; align-items: center; justify-content: center; padding: 2rem; }
  .auth-card { max-width: 440px; width: 100%; padding: 2.5rem; border-radius: var(--radius-xl); }
  .auth-header { text-align: center; margin-bottom: 2rem; }
  .auth-title { font-size: 1.65rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.01em; }
  .auth-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
  .form-label { font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); }
  .btn-full { width: 100%; justify-content: center; }
  .auth-footer { text-align: center; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .auth-footer p { font-size: 0.875rem; }
</style>

