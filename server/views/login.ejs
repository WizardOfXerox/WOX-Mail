<%- include('layouts/base', { title: 'Login', body: `

<div class="auth-page">
  <div class="auth-card card">
    
    <!-- Multi-Account Chooser View (Displayed when saved accounts exist) -->
    <div id="account-chooser-container" style="display: none;">
      <div class="auth-header">
        <div class="stat-icon-wrap" style="margin: 0 auto 1rem; width: 56px; height: 56px; border-radius: 16px; background: rgba(124, 58, 237, 0.15); border: 1px solid rgba(124, 58, 237, 0.3);">
          <svg class="stat-icon text-purple" style="width: 28px; height: 28px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h1 class="auth-title">Choose an account</h1>
        <p class="text-secondary" style="font-size: 0.9rem;">to continue to Sovereign WoxMail</p>
      </div>

      <div id="saved-accounts-list" class="saved-accounts-list">
        <!-- Rendered dynamically by WoxAccountManager -->
      </div>

      <div style="margin-top: 1.25rem;">
        <button type="button" class="btn btn-secondary btn-full btn-lg" onclick="WoxAccountManager.showManualLogin()" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 600;">
          <svg class="icon-svg" style="width: 18px; height: 18px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Use another account</span>
        </button>
      </div>
    </div>

    <!-- Selected Account Preview Header (Shown when an account from chooser is selected) -->
    <div id="selected-account-card" class="selected-account-card" style="display: none; margin-bottom: 1.5rem;">
      <!-- Populated dynamically -->
    </div>

    <!-- Standard Login Header (Shown during manual login) -->
    <div id="manual-login-header" class="auth-header">
      <div class="stat-icon-wrap" style="margin: 0 auto 1rem; width: 56px; height: 56px; border-radius: 16px;">
        <svg class="stat-icon text-purple" style="width: 28px; height: 28px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </div>
      <h1 class="auth-title">Welcome back</h1>
      <p class="text-secondary" style="font-size: 0.85rem;">Sign in with @wox.world or directly with your @gmail.com, Outlook, or Yahoo App Password</p>
    </div>

    <!-- Step 1: Email/Username + Password -->
    <form id="login-form" class="auth-form">
      <div class="form-group" id="email-field-group">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
          <label for="email" class="form-label" style="margin: 0;">Email or Username</label>
          <span id="domain-badge" class="badge" style="display: none; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em;"></span>
        </div>
        <input type="text" id="email" name="email" class="input mono" placeholder="you@wox.world, you@gmail.com, or username" required autocomplete="username" autofocus>
      </div>

      <!-- Custom Domain Server Configuration Drawer (Revealed dynamically for custom domains) -->
      <div id="custom-server-drawer" style="display: none; background: var(--color-bg-input); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1rem; margin-top: -0.25rem; transition: all 0.25s ease;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <span style="font-size: 0.8125rem; font-weight: 700; color: var(--color-primary-light); display: inline-flex; align-items: center; gap: 0.4rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
            <span>Mail Server Configuration</span>
          </span>
          <span class="text-tertiary" style="font-size: 0.75rem; font-weight: 600;">Custom IMAP / SMTP</span>
        </div>

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.6rem; margin-bottom: 0.6rem;">
          <div class="form-group" style="margin: 0;">
            <label for="imap_host" class="form-label" style="font-size: 0.75rem;">IMAP Host</label>
            <input type="text" id="imap_host" name="imap_host" class="input mono btn-sm" placeholder="mail.domain.com" style="font-size: 0.8125rem; padding: 0.45rem 0.65rem;">
          </div>
          <div class="form-group" style="margin: 0;">
            <label for="imap_port" class="form-label" style="font-size: 0.75rem;">Port</label>
            <input type="number" id="imap_port" name="imap_port" class="input mono btn-sm" value="993" style="font-size: 0.8125rem; padding: 0.45rem 0.65rem;">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.6rem; margin-bottom: 0.6rem;">
          <div class="form-group" style="margin: 0;">
            <label for="smtp_host" class="form-label" style="font-size: 0.75rem;">SMTP Host</label>
            <input type="text" id="smtp_host" name="smtp_host" class="input mono btn-sm" placeholder="mail.domain.com" style="font-size: 0.8125rem; padding: 0.45rem 0.65rem;">
          </div>
          <div class="form-group" style="margin: 0;">
            <label for="smtp_port" class="form-label" style="font-size: 0.75rem;">Port</label>
            <input type="number" id="smtp_port" name="smtp_port" class="input mono btn-sm" value="465" style="font-size: 0.8125rem; padding: 0.45rem 0.65rem;">
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.25rem;">
          <label style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--color-text-secondary); cursor: pointer; user-select: none;">
            <input type="checkbox" id="imap_secure" name="imap_secure" checked style="accent-color: var(--color-primary); width: 14px; height: 14px; cursor: pointer;">
            <span>SSL / TLS Encryption</span>
          </label>
          <span id="server-status-hint" class="text-tertiary" style="font-size: 0.72rem;">Port 993/465 (SSL)</span>
        </div>
      </div>

      <div class="form-group">
        <label for="password" class="form-label" id="password-label">Password / App Password</label>
        <div class="input-wrapper">
          <input type="password" id="password" name="password" class="input" placeholder="••••••••" required autocomplete="current-password">
          <button type="button" class="input-toggle" onclick="togglePassword()" aria-label="Show password">
            <svg class="icon-svg text-secondary" id="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div class="form-group" style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: -0.25rem;">
        <label style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--color-text-secondary); cursor: pointer; user-select: none;">
          <input type="checkbox" id="remember-me" name="rememberMe" checked style="accent-color: var(--color-primary); width: 16px; height: 16px; cursor: pointer; border-radius: 4px;">
          <span>Remember me on this device</span>
        </label>
      </div>

      <button type="submit" class="btn btn-primary btn-lg btn-full" id="login-btn">
        <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
        <span>Sign In</span>
      </button>

      <div class="auth-links" style="display: flex; justify-content: space-between; align-items: center;">
        <a href="/forgot-password" class="text-secondary">Forgot password?</a>
        <a href="#" id="view-saved-accounts-link" style="display: none; font-size: 0.875rem; color: var(--color-primary-light); font-weight: 600;" onclick="WoxAccountManager.showChooser(); return false;">Saved accounts</a>
      </div>
    </form>

    <!-- Step 2: TOTP Code (shown if 2FA required) -->
    <form id="otp-form" class="auth-form" style="display: none;">
      <div class="otp-info">
        <div class="stat-icon-wrap" style="margin: 0 auto 0.75rem;">
          <svg class="stat-icon text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <p class="text-secondary" style="font-size: 0.875rem;">Enter the 6-digit verification code from your authenticator app</p>
      </div>

      <div class="form-group">
        <input type="text" id="otp-code" name="code" class="input input-otp mono"
               placeholder="000000" maxlength="6" pattern="[0-9]{6}"
               inputmode="numeric" autocomplete="one-time-code" autofocus>
      </div>

      <button type="submit" class="btn btn-primary btn-lg btn-full" id="otp-btn">
        <span>Verify Code</span>
      </button>

      <div class="auth-links" style="display:flex;flex-direction:column;gap:0.5rem;">
        <a href="#" onclick="showRecoveryInput(); return false;">Use recovery code instead</a>
        <a href="#" onclick="backToLogin(); return false;" class="text-secondary">← Back to login</a>
      </div>
    </form>

    <div class="auth-footer">
      <p class="text-secondary" style="font-size: 0.8125rem; margin-bottom: 0.5rem; line-height: 1.5; display:flex; align-items:flex-start; gap:0.4rem;">
        <span style="display:inline-flex; color:var(--color-primary-light); margin-top:2px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        <span><strong>Direct External Login:</strong> Sign in directly with any <strong>@gmail.com, Outlook, Yahoo</strong>, or any <strong>custom email domain</strong> (with custom IMAP/SMTP server settings) without needing an invite code.</span>
      </p>
      <p class="text-secondary" style="font-size: 0.8125rem; margin-bottom: 0.5rem;">
        Have a @wox.world invitation? <a href="/register" style="color: var(--color-primary-light); font-weight: 600; text-decoration: underline;">Redeem Invite Code &rarr;</a>
      </p>
    </div>
  </div>
</div>

`, scripts: '<script src="/js/account-manager.js"></script><script src="/js/auth.js"></script>', showFooter: false }) %>

<style>
  .auth-page { min-height: calc(100vh - var(--nav-height)); display: flex; align-items: center; justify-content: center; padding: 2rem; }
  .auth-card { max-width: 460px; width: 100%; padding: 2.5rem; border-radius: var(--radius-xl); box-shadow: 0 20px 50px rgba(0,0,0,0.4); }
  .auth-header { text-align: center; margin-bottom: 2rem; }
  .auth-title { font-size: 1.65rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.01em; }
  .auth-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
  .form-label { font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); }
  .input-wrapper { position: relative; }
  .input-wrapper .input { padding-right: 3rem; }
  .input-toggle { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0.25rem; }
  .btn-full { width: 100%; justify-content: center; }
  .auth-links { text-align: center; }
  .auth-links a { font-size: 0.875rem; color: var(--color-primary-light); }
  .auth-footer { text-align: center; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .auth-footer p { font-size: 0.875rem; }

  .otp-info { text-align: center; margin-bottom: 0.5rem; }
  .input-otp { text-align: center; font-size: 1.75rem; letter-spacing: 0.5rem; padding: 0.75rem; }

  /* Multi-Account Chooser Styling */
  .saved-accounts-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 280px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }
  .saved-account-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }
  .saved-account-item:hover {
    background: rgba(124, 58, 237, 0.12);
    border-color: rgba(139, 92, 246, 0.4);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.15);
  }
  .account-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  .account-details {
    flex: 1;
    min-width: 0;
    text-align: left;
  }
  .account-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account-email {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: 'JetBrains Mono', monospace;
  }
  .account-remove-btn {
    background: none;
    border: none;
    color: #71717a;
    font-size: 0.9rem;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    opacity: 0.6;
  }
  .account-remove-btn:hover {
    opacity: 1;
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }
  .admin-pill {
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    background: rgba(236, 72, 153, 0.2);
    color: #f472b6;
    font-weight: 700;
  }

  /* Selected Account Card */
  .selected-account-card {
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 14px;
    padding: 0.85rem 1.1rem;
  }
  .selected-account-inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
</style>
