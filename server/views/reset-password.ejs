<%
  const safeTokenJson = JSON.stringify(typeof token !== 'undefined' ? String(token || '') : '').replace(/</g, '\\u003c');
%>
<%- include('layouts/base', { title: 'Reset Password', body: `

<div class="auth-page">
  <div class="auth-card card">
    <div class="auth-header">
      <div class="stat-icon-wrap" style="margin: 0 auto 1rem; width: 56px; height: 56px; border-radius: 16px;">
        <svg class="stat-icon text-purple" style="width: 28px; height: 28px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h1 class="auth-title">Set New Password</h1>
      <p class="text-secondary">Choose a strong new password for your WoxMail account</p>
    </div>

    <div id="reset-missing-token" class="alert alert-error" style="display: none; margin-bottom: 1rem;">
      Reset token is missing or invalid. Please request a new reset link.
    </div>

    <form id="reset-password-form" class="auth-form">
      <div class="form-group">
        <label for="reset-password" class="form-label">New Password</label>
        <input type="password" id="reset-password" class="input" placeholder="Min 8 characters (upper, lower, digit)" required minlength="8" autocomplete="new-password">
      </div>
      <div class="form-group">
        <label for="reset-password-confirm" class="form-label">Confirm New Password</label>
        <input type="password" id="reset-password-confirm" class="input" placeholder="Repeat new password" required minlength="8" autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-full" id="reset-submit-btn">
        <span>Update Password</span>
      </button>
    </form>

    <div class="auth-footer">
      <a href="/forgot-password" class="text-secondary">Request a new reset link</a>
      <span style="margin: 0 0.5rem; color: var(--color-text-tertiary);">·</span>
      <a href="/login" class="text-secondary">Back to login</a>
    </div>
  </div>
</div>

`, scripts: `
<script>
(function () {
  const initialToken = ${safeTokenJson} || new URLSearchParams(window.location.search).get('token') || '';
  const form = document.getElementById('reset-password-form');
  const missingEl = document.getElementById('reset-missing-token');

  if (!initialToken && missingEl && form) {
    missingEl.style.display = 'block';
    form.style.display = 'none';
  }

  function getCsrfToken() {
    const m = document.cookie.match(/woxmail_csrf=([^;]+)/);
    return m ? decodeURIComponent(m[1]) : '';
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = document.getElementById('reset-password').value;
      const confirm = document.getElementById('reset-password-confirm').value;
      const btn = document.getElementById('reset-submit-btn');

      if (password !== confirm) {
        return WoxToast && WoxToast.error('Passwords do not match');
      }

      btn.disabled = true;
      btn.textContent = 'Updating...';
      try {
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify({ token: initialToken, password }),
        });
        const data = await res.json();
        if (!res.ok) {
          const msg = data.details ? data.details.join(', ') : (data.error || 'Reset failed');
          return WoxToast && WoxToast.error(msg);
        }
        if (window.WoxToast) WoxToast.success(data.message || 'Password reset successfully!');
        setTimeout(() => { window.location.href = '/login'; }, 1500);
      } catch {
        if (window.WoxToast) WoxToast.error('Network error. Try again.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Update Password';
      }
    });
  }
})();
</script>
`, showFooter: false }) %>

<style>
  .auth-page { min-height: calc(100vh - var(--nav-height)); display: flex; align-items: center; justify-content: center; padding: 2rem; }
  .auth-card { max-width: 440px; width: 100%; padding: 2.5rem; border-radius: var(--radius-xl); }
  .auth-header { text-align: center; margin-bottom: 1.5rem; }
  .auth-title { font-size: 1.65rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.01em; }
  .auth-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
  .form-label { font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); }
  .btn-full { width: 100%; justify-content: center; }
  .auth-footer { text-align: center; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); font-size: 0.875rem; }
</style>
