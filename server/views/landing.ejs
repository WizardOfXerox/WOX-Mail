<script>
  let currentHeroExpiryHours = 24;
  let currentHeroMode = 'pool';
  let heroExpiresAt = null;
  let savedPoolExpiresAt = null;
  let heroCountdownInterval = null;

  function getCsrfToken() {
    const match = document.cookie.match(/woxmail_csrf=([^;]+)/);
    return match ? match[1] : '';
  }

  function formatDurationLabel(hours) {
    if (hours >= 24) {
      const days = hours / 24;
      return days + ' Day' + (days > 1 ? 's' : '');
    }
    return hours + ' Hour' + (hours > 1 ? 's' : '');
  }

  function setLiveShader(mode) {
    localStorage.setItem('woxmail_bg_mode', mode);
    if (window.WoxBackground?.setMode) {
      window.WoxBackground.setMode(mode);
    }
    if (window.WoxToast) {
      window.WoxToast.info('Switched shader to ' + mode.replace('_', ' '));
    }
  }

  function setLiveAccent(accent) {
    if (window.WoxTheme?.setAccent) {
      window.WoxTheme.setAccent(accent);
    } else {
      localStorage.setItem('woxmail_accent', accent);
      document.documentElement.setAttribute('data-accent', accent);
    }
    if (window.WoxToast) {
      window.WoxToast.success('Accent color set to ' + accent);
    }
  }

  function setHeroMode(mode) {
    currentHeroMode = mode;
    const poolBtn = document.getElementById('mode-btn-pool');
    const customBtn = document.getElementById('mode-btn-custom');
    const poolContainer = document.getElementById('hero-pool-container');
    const customContainer = document.getElementById('hero-custom-container');
    const lifespanRow = document.getElementById('hero-lifespan-selector-row');
    const sourceBadge = document.getElementById('hero-source-badge');
    const pill = document.getElementById('hero-countdown-pill');
    const exactTime = document.getElementById('hero-exact-time');

    if (mode === 'pool') {
      if (poolBtn) {
        poolBtn.style.background = 'var(--color-primary)';
        poolBtn.style.color = '#fff';
        poolBtn.style.fontWeight = '600';
      }
      if (customBtn) {
        customBtn.style.background = 'transparent';
        customBtn.style.color = 'var(--color-text-secondary)';
        customBtn.style.fontWeight = '500';
      }
      if (poolContainer) poolContainer.style.display = 'flex';
      if (customContainer) customContainer.style.display = 'none';
      if (lifespanRow) lifespanRow.style.display = 'none';
      if (sourceBadge) {
        sourceBadge.textContent = 'Standby Pool (<5ms)';
        sourceBadge.className = 'badge badge-green';
      }
      if (savedPoolExpiresAt && new Date(savedPoolExpiresAt).getTime() > Date.now()) {
        startHeroCountdown(savedPoolExpiresAt);
      } else {
        generateHeroTempAddress(false);
      }
    } else {
      if (customBtn) {
        customBtn.style.background = 'var(--color-primary)';
        customBtn.style.color = '#fff';
        customBtn.style.fontWeight = '600';
      }
      if (poolBtn) {
        poolBtn.style.background = 'transparent';
        poolBtn.style.color = 'var(--color-text-secondary)';
        poolBtn.style.fontWeight = '500';
      }
      if (poolContainer) poolContainer.style.display = 'none';
      if (customContainer) customContainer.style.display = 'flex';
      if (lifespanRow) lifespanRow.style.display = 'flex';
      if (sourceBadge) {
        sourceBadge.textContent = 'User-Generated Handle';
        sourceBadge.className = 'badge badge-purple';
      }
      if (heroCountdownInterval) clearInterval(heroCountdownInterval);
      if (pill) {
        pill.textContent = 'Lifespan: ' + formatDurationLabel(currentHeroExpiryHours);
        pill.className = 'badge badge-purple';
      }
      if (exactTime) {
        exactTime.textContent = '• Valid for ' + formatDurationLabel(currentHeroExpiryHours) + ' upon creation';
      }
      const customInput = document.getElementById('hero-custom-input');
      if (customInput) customInput.focus();
    }
  }

  function selectHeroDuration(hours) {
    currentHeroExpiryHours = hours;
    document.querySelectorAll('.duration-pills .duration-btn').forEach(btn => {
      const btnHours = parseInt(btn.getAttribute('data-hours'), 10);
      if (btnHours === hours) {
        btn.classList.add('active');
        btn.style.background = 'var(--color-primary)';
        btn.style.color = '#fff';
        btn.style.borderColor = 'var(--color-primary)';
        btn.style.fontWeight = '600';
      } else {
        btn.classList.remove('active');
        btn.style.background = 'var(--color-bg-hover)';
        btn.style.color = 'var(--color-text-secondary)';
        btn.style.borderColor = 'var(--color-border)';
        btn.style.fontWeight = '500';
      }
    });

    const hoursLabel = document.getElementById('hero-hours-label');
    if (hoursLabel) {
      hoursLabel.textContent = formatDurationLabel(hours);
    }

    if (currentHeroMode === 'custom') {
      const pill = document.getElementById('hero-countdown-pill');
      const exactTime = document.getElementById('hero-exact-time');
      if (pill) {
        pill.textContent = 'Lifespan: ' + formatDurationLabel(hours);
        pill.className = 'badge badge-purple';
      }
      if (exactTime) {
        exactTime.textContent = '• Valid for ' + formatDurationLabel(hours) + ' upon creation';
      }
    } else {
      generateHeroTempAddress(true);
    }
  }

  function startHeroCountdown(expiresAtIso) {
    if (heroCountdownInterval) clearInterval(heroCountdownInterval);
    heroExpiresAt = new Date(expiresAtIso).getTime();
    if (currentHeroMode === 'pool') {
      savedPoolExpiresAt = expiresAtIso;
    }

    function update() {
      const pill = document.getElementById('hero-countdown-pill');
      const exactTime = document.getElementById('hero-exact-time');
      if (!pill) return;

      const now = Date.now();
      const diffMs = heroExpiresAt - now;

      if (diffMs <= 0) {
        pill.textContent = 'Expired';
        pill.className = 'badge badge-red';
        if (heroCountdownInterval) clearInterval(heroCountdownInterval);
        return;
      }

      const totalSec = Math.floor(diffMs / 1000);
      const hours = Math.floor(totalSec / 3600);
      const minutes = Math.floor((totalSec % 3600) / 60);
      const seconds = totalSec % 60;

      pill.textContent = (hours > 0 ? hours + 'h ' : '') + minutes + 'm ' + seconds + 's left';
      pill.className = 'badge badge-purple';

      if (exactTime) {
        const expDate = new Date(heroExpiresAt);
        exactTime.textContent = '• Until: ' + expDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' (' + expDate.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ')';
      }
    }

    update();
    heroCountdownInterval = setInterval(update, 1000);
  }

  async function generateHeroTempAddress(forceNew = false) {
    const input = document.getElementById('hero-address-preview');
    const inboxLink = document.getElementById('hero-inbox-link');
    const sourceBadge = document.getElementById('hero-source-badge');
    
    if (!forceNew) {
      try {
        const sessionRes = await fetch('/api/tempmail/session', { credentials: 'include' });
        const sessionData = await sessionRes.json();
        if (sessionData && sessionData.active && sessionData.address) {
          input.value = sessionData.address;
          if (inboxLink) inboxLink.href = '/tempmail?address=' + encodeURIComponent(sessionData.address);
          localStorage.setItem('woxmail_temp_addr', sessionData.address);
          if (sourceBadge) {
            sourceBadge.textContent = sessionData.isCustom ? 'User-Generated' : 'Standby Pool (<5ms)';
            sourceBadge.className = sessionData.isCustom ? 'badge badge-purple' : 'badge badge-green';
          }
          if (sessionData.expiresAt) startHeroCountdown(sessionData.expiresAt);
          return;
        }
      } catch {}
    }

    input.value = 'Claiming from standby pool...';

    try {
      const res = await fetch('/api/tempmail/generate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': getCsrfToken(),
        },
        credentials: 'include',
        body: JSON.stringify({ expiryHours: currentHeroExpiryHours, captchaToken: 'dev-bypass', forceNew })
      });
      const data = await res.json();
      if (data && data.address) {
        input.value = data.address;
        if (inboxLink) inboxLink.href = '/tempmail?address=' + encodeURIComponent(data.address);
        localStorage.setItem('woxmail_temp_addr', data.address);
        if (sourceBadge) {
          sourceBadge.textContent = data.isCustom ? 'User-Generated' : 'Standby Pool (<5ms)';
          sourceBadge.className = data.isCustom ? 'badge badge-purple' : 'badge badge-green';
        }
        if (data.expiresAt) startHeroCountdown(data.expiresAt);
        return;
      }
    } catch (err) {
      console.warn('Backend pool error:', err);
    }

    const fallbackAddr = 'guest_' + Math.floor(Math.random() * 899999 + 100000) + '@mail.wox.world';
    input.value = fallbackAddr;
    if (inboxLink) inboxLink.href = '/tempmail?address=' + encodeURIComponent(fallbackAddr);
    startHeroCountdown(new Date(Date.now() + currentHeroExpiryHours * 3600000).toISOString());
  }

  async function generateCustomHeroAddress() {
    const customInput = document.getElementById('hero-custom-input');
    const customVal = (customInput?.value || '').trim().toLowerCase().replace(/[^a-z0-9._-]/g, '');

    if (!customVal || customVal.length < 3) {
      if (window.WoxToast) window.WoxToast.warning('Username must be at least 3 alphanumeric characters');
      else alert('Username must be at least 3 alphanumeric characters');
      return;
    }

    const input = document.getElementById('hero-address-preview');
    const inboxLink = document.getElementById('hero-inbox-link');
    const sourceBadge = document.getElementById('hero-source-badge');

    input.value = 'Creating ' + customVal + '@mail.wox.world...';
    setHeroMode('pool');

    try {
      const res = await fetch('/api/tempmail/generate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': getCsrfToken(),
        },
        credentials: 'include',
        body: JSON.stringify({ username: customVal, expiryHours: currentHeroExpiryHours, captchaToken: 'dev-bypass', forceNew: true })
      });
      const data = await res.json();
      if (data && data.address) {
        input.value = data.address;
        if (inboxLink) inboxLink.href = '/tempmail?address=' + encodeURIComponent(data.address);
        localStorage.setItem('woxmail_temp_addr', data.address);
        if (sourceBadge) {
          sourceBadge.textContent = 'User-Generated Handle';
          sourceBadge.className = 'badge badge-purple';
        }
        if (data.expiresAt) startHeroCountdown(data.expiresAt);
        if (window.WoxToast) window.WoxToast.success('Created custom address: ' + data.address);
        return;
      }
    } catch (err) {
      console.warn('Custom generation error:', err);
    }
  }

  function copyHeroAddress() {
    const input = document.getElementById('hero-address-preview');
    if (input && input.value && !input.value.startsWith('Generating') && !input.value.startsWith('Claiming')) {
      navigator.clipboard.writeText(input.value);
      if (window.WoxToast) window.WoxToast.success('Copied ' + input.value + ' to clipboard!');
      else alert('Copied ' + input.value + ' to clipboard!');
    }
  }

  function toggleFaq(btn) {
    const card = btn.closest('.faq-card');
    if (card) {
      card.classList.toggle('open');
    }
  }

