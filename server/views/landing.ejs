<% const title = 'Home'; const description = 'WoxMail — Sovereign Encrypted Webmail, Disposable Temp Mail & Privacy Suite'; %>
<%- include('layouts/base', { body: `

<!-- Hero Section with Ambient Glow -->
<section class="landing-hero" style="position: relative; padding: 4.5rem 0 3.5rem; overflow: hidden;">
  <div class="landing-glow-orb"></div>
  <div class="container" style="position: relative; z-index: 1;">
    <div class="landing-pill-badge" style="margin-bottom: 1.25rem;">
      <span class="status-dot-pulse"></span>
      <span>Sovereign Privacy Enclave • Live on <strong style="color:var(--color-text-primary);">wox.world</strong></span>
    </div>

    <h1 class="landing-title" style="font-family: 'Outfit', var(--font-body); font-size: clamp(2.2rem, 5vw, 3.75rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.03em; margin-bottom: 1.25rem;">
      Private Email Crafted for <br/>
      <span class="gradient-text">Absolute Freedom & Speed.</span>
    </h1>

    <p class="landing-subtitle" style="font-size: clamp(1rem, 2vw, 1.2rem); color: var(--color-text-secondary); max-width: 680px; margin: 0 auto 2rem; line-height: 1.6;">
      Zero trackers, zero advertising telemetry, and zero data mining. Shield your real identity with disposable temp inboxes or own a permanent encrypted enclave mailbox.
    </p>

    <!-- Instant Live Generator Card -->
    <div class="landing-instant-card" style="background: rgba(18, 18, 36, 0.75); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.75rem; max-width: 720px; margin: 0 auto 2.5rem; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45); text-align: left;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 0.9375rem; font-weight: 700; color: #c084fc; display: flex; align-items: center; gap: 0.4rem;">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span>Instant Disposable Mailbox</span>
          </span>
          <span id="hero-source-badge" class="badge badge-green" style="font-size: 0.72rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span>Standby Pool (&lt;5ms)</span>
          </span>
        </div>

        <!-- Mode Toggle (Pool vs Custom) -->
        <div class="hero-mode-pills" style="display: inline-flex; background: rgba(10, 10, 22, 0.6); border: 1px solid var(--color-border); border-radius: var(--radius-pill); padding: 3px; gap: 3px;">
          <button type="button" id="mode-btn-pool" class="btn btn-sm" onclick="setHeroMode('pool')" style="border-radius: var(--radius-pill); padding: 0.35rem 0.85rem; font-size: 0.78rem; background: var(--color-primary); color: #fff; border: none; font-weight: 600; cursor: pointer; transition: all 0.15s ease;">
            <span style="display: inline-flex; align-items: center; gap: 0.35rem;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg><span>Instant Pool</span></span>
          </button>
          <button type="button" id="mode-btn-custom" class="btn btn-sm" onclick="setHeroMode('custom')" style="border-radius: var(--radius-pill); padding: 0.35rem 0.85rem; font-size: 0.78rem; background: transparent; color: var(--color-text-secondary); border: none; font-weight: 500; cursor: pointer; transition: all 0.15s ease;">
            <span style="display: inline-flex; align-items: center; gap: 0.35rem;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><span>Custom Handle</span></span>
          </button>
        </div>
      </div>

      <!-- Address Display & Action Bar -->
      <div id="hero-pool-container" style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem;">
        <div style="flex: 1; min-width: 220px; position: relative;">
          <input
            type="text"
            id="hero-address-preview"
            class="input mono"
            style="padding-left: 2.2rem; font-weight: 600; font-size: 0.9375rem; background: var(--color-bg-input); border-color: rgba(124, 58, 237, 0.4); color: var(--color-text-primary); height: 48px; border-radius: var(--radius-md);"
            value="Generating secure address..."
            readonly
          />
          <span style="position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%); display: inline-flex; color: var(--color-primary-light); pointer-events: none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
        </div>

        <button
          type="button"
          class="btn btn-secondary btn-sm"
          id="hero-copy-btn"
          onclick="copyHeroAddress()"
          title="Copy address to clipboard"
          style="gap: 0.4rem; padding: 0 1.15rem; min-height: 48px; font-weight: 600; border-radius: var(--radius-md);"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span>Copy</span>
        </button>

        <button
          type="button"
          class="btn btn-secondary btn-sm"
          id="hero-refresh-btn"
          onclick="generateHeroTempAddress(true)"
          title="Claim a fresh address from pool"
          style="gap: 0.4rem; padding: 0 1rem; min-height: 48px; font-weight: 600; border-radius: var(--radius-md);"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
          <span>New</span>
        </button>

        <a
          href="/tempmail"
          class="btn btn-primary btn-sm"
          id="hero-inbox-link"
          style="gap: 0.4rem; padding: 0 1.25rem; font-weight: 700; min-height: 48px; display: inline-flex; align-items: center; border-radius: var(--radius-md);"
        >
          <span>Open Inbox</span>
          <span>→</span>
        </a>
      </div>

      <!-- Custom Handle Input Row -->
      <div id="hero-custom-container" style="display: none; gap: 0.6rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem;">
        <div style="flex: 1; min-width: 220px; display: flex; align-items: center; position: relative;">
          <input
            type="text"
            id="hero-custom-input"
            class="input mono"
            placeholder="e.g. satoshi"
            style="padding-left: 2.2rem; padding-right: 120px; font-weight: 600; font-size: 0.9375rem; background: var(--color-bg-input); border-color: rgba(124, 58, 237, 0.4); color: var(--color-text-primary); height: 48px; border-radius: var(--radius-md);"
            onkeydown="if(event.key==='Enter') generateCustomHeroAddress()"
          />
          <span style="position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%); display: inline-flex; color: var(--color-primary-light); pointer-events: none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </span>
          <span style="position: absolute; right: 0.85rem; top: 50%; transform: translateY(-50%); font-size: 0.8125rem; color: var(--color-text-tertiary); font-family: var(--font-mono); pointer-events: none;">@mail.wox.world</span>
        </div>

        <button
          type="button"
          class="btn btn-primary btn-sm"
          onclick="generateCustomHeroAddress()"
          style="gap: 0.35rem; padding: 0 1.25rem; font-weight: 700; min-height: 48px; border-radius: var(--radius-md);"
        >
          <span>Create Handle</span>
        </button>
      </div>

      <!-- Expiry Duration Selector (Visible in Custom Handle Mode) -->
      <div id="hero-lifespan-selector-row" style="display: none; align-items: center; justify-content: space-between; padding: 0.85rem 1rem; margin-bottom: 0.85rem; background: rgba(10, 10, 22, 0.5); border: 1px dashed var(--color-border-focus); border-radius: var(--radius-md); flex-wrap: wrap; gap: 0.75rem;">
        <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
          <span style="font-size: 0.8125rem; font-weight: 600; color: var(--color-text-primary); display: flex; align-items: center; gap: 0.3rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Lifespan:</span>
          </span>
          <div class="duration-pills" style="display: inline-flex; gap: 0.35rem; flex-wrap: wrap;">
            <button type="button" class="duration-btn expiry-btn" data-hours="1" onclick="selectHeroDuration(1)" style="padding: 0.3rem 0.7rem; font-size: 0.75rem; border-radius: var(--radius-pill); border: 1px solid var(--color-border); background: var(--color-bg-hover); color: var(--color-text-secondary); cursor: pointer;">1h</button>
            <button type="button" class="duration-btn expiry-btn" data-hours="6" onclick="selectHeroDuration(6)" style="padding: 0.3rem 0.7rem; font-size: 0.75rem; border-radius: var(--radius-pill); border: 1px solid var(--color-border); background: var(--color-bg-hover); color: var(--color-text-secondary); cursor: pointer;">6h</button>
            <button type="button" class="duration-btn expiry-btn active" data-hours="24" onclick="selectHeroDuration(24)" style="padding: 0.3rem 0.7rem; font-size: 0.75rem; border-radius: var(--radius-pill); border: 1px solid var(--color-primary); background: var(--color-primary); color: #fff; font-weight: 600; cursor: pointer;">24h</button>
            <button type="button" class="duration-btn expiry-btn" data-hours="48" onclick="selectHeroDuration(48)" style="padding: 0.3rem 0.7rem; font-size: 0.75rem; border-radius: var(--radius-pill); border: 1px solid var(--color-border); background: var(--color-bg-hover); color: var(--color-text-secondary); cursor: pointer;">48h</button>
            <button type="button" class="duration-btn expiry-btn" data-hours="72" onclick="selectHeroDuration(72)" style="padding: 0.3rem 0.7rem; font-size: 0.75rem; border-radius: var(--radius-pill); border: 1px solid var(--color-border); background: var(--color-bg-hover); color: var(--color-text-secondary); cursor: pointer;">72h</button>
          </div>
        </div>
        <span class="text-secondary" style="font-size: 0.75rem;">Selected: <strong style="color: var(--color-primary-light);" id="hero-hours-label">24 Hours</strong></span>
      </div>

      <!-- Expiry Details & Status Bar -->
      <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.85rem; border-top: 1px solid var(--color-border); font-size: 0.75rem; color: var(--color-text-tertiary); flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
          <span class="badge badge-purple" id="hero-countdown-pill" style="padding: 0.25rem 0.6rem; font-size: 0.75rem; font-family: var(--font-mono);">
            Calculating remaining time...
          </span>
          <span id="hero-exact-time" style="font-weight: 500;"></span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <span style="display: inline-flex; align-items: center; gap: 0.35rem;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Zero-Log Encrypted</span></span>
          <span style="display: inline-flex; align-items: center; gap: 0.35rem;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg><span>Purelymail Ingest</span></span>
        </div>
      </div>
    </div>

    <!-- Live Interactive Shader & Palette Customizer Strip -->
    <div style="background: rgba(14, 14, 28, 0.65); border: 1px solid var(--color-border); border-radius: var(--radius-pill); padding: 0.5rem 1rem; max-width: 720px; margin: 0 auto 2.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; backdrop-filter: blur(12px);">
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span style="font-size: 0.78rem; font-weight: 700; color: var(--color-text-secondary); display: flex; align-items: center; gap: 0.3rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20z"/></svg>
          <span>Live Shaders:</span>
        </span>
        <button type="button" class="btn btn-ghost btn-xs" onclick="setLiveShader('aurora')" title="Aurora Atmospheric Waves" style="font-size: 0.72rem; padding: 0.2rem 0.55rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill);">Aurora</button>
        <button type="button" class="btn btn-ghost btn-xs" onclick="setLiveShader('cyber_mesh')" title="3D Perspective Wireframe Grid" style="font-size: 0.72rem; padding: 0.2rem 0.55rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill);">Cyber Mesh</button>
        <button type="button" class="btn btn-ghost btn-xs" onclick="setLiveShader('deep_space')" title="Parallax Deep Space Starfield" style="font-size: 0.72rem; padding: 0.2rem 0.55rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill);">Starfield</button>
        <button type="button" class="btn btn-ghost btn-xs" onclick="setLiveShader('matrix')" title="Matrix Terminal Rain" style="font-size: 0.72rem; padding: 0.2rem 0.55rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill);">Matrix</button>
        <button type="button" class="btn btn-ghost btn-xs" onclick="setLiveShader('zen_drift')" title="Zen Radial Bloom" style="font-size: 0.72rem; padding: 0.2rem 0.55rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill);">Zen</button>
        <button type="button" class="btn btn-ghost btn-xs" onclick="setLiveShader('oled_monochrome')" title="Pure OLED Black" style="font-size: 0.72rem; padding: 0.2rem 0.55rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill);">OLED</button>
      </div>

      <div style="display: flex; align-items: center; gap: 0.35rem;">
        <span style="font-size: 0.72rem; color: var(--color-text-tertiary);">Accent:</span>
        <button type="button" onclick="setLiveAccent('purple')" title="Sovereign Purple" style="width: 16px; height: 16px; border-radius: 50%; background: #7c3aed; border: none; cursor: pointer;"></button>
        <button type="button" onclick="setLiveAccent('emerald')" title="Cyber Emerald" style="width: 16px; height: 16px; border-radius: 50%; background: #10b981; border: none; cursor: pointer;"></button>
        <button type="button" onclick="setLiveAccent('cobalt')" title="Midnight Cobalt" style="width: 16px; height: 16px; border-radius: 50%; background: #3b82f6; border: none; cursor: pointer;"></button>
        <button type="button" onclick="setLiveAccent('amber')" title="Sunset Amber" style="width: 16px; height: 16px; border-radius: 50%; background: #f59e0b; border: none; cursor: pointer;"></button>
        <button type="button" onclick="setLiveAccent('cyan')" title="Matrix Cyan" style="width: 16px; height: 16px; border-radius: 50%; background: #06b6d4; border: none; cursor: pointer;"></button>
        <button type="button" onclick="setLiveAccent('crimson')" title="Crimson Red" style="width: 16px; height: 16px; border-radius: 50%; background: #ef4444; border: none; cursor: pointer;"></button>
      </div>
    </div>

    <!-- Quick CTA Navigation Buttons -->
    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      ${typeof user !== 'undefined' && user ? `
        <a href="/dashboard" class="btn btn-primary btn-lg" style="gap: 0.5rem; box-shadow: 0 0 30px var(--color-primary-glow); min-height: 48px; border-radius: var(--radius-pill);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>Open My Webmail (${user.username}) →</span>
        </a>
        <a href="/tempmail" class="btn btn-secondary btn-lg" style="gap: 0.5rem; min-height: 48px; border-radius: var(--radius-pill);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Disposable Temp Mail</span>
        </a>
        <a href="/futureme" class="btn btn-ghost btn-lg" style="gap: 0.5rem; min-height: 48px; border-radius: var(--radius-pill);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
          <span>Future Letters Vault</span>
        </a>
      ` : `
        <a href="/tempmail" class="btn btn-primary btn-lg" style="gap: 0.5rem; box-shadow: 0 0 30px var(--color-primary-glow); min-height: 48px; border-radius: var(--radius-pill);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Disposable Temp Mail</span>
        </a>
        <a href="/login" class="btn btn-secondary btn-lg" style="gap: 0.5rem; min-height: 48px; border-radius: var(--radius-pill);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Webmail Login</span>
        </a>
        <a href="/register" class="btn btn-ghost btn-lg" style="gap: 0.5rem; min-height: 48px; border-radius: var(--radius-pill);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
          <span>Join with Invite Code</span>
        </a>
      `}
    </div>
  </div>
</section>

<!-- Trust & Telemetry Bar -->
<section style="padding: 2.25rem 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-bg-elevated); backdrop-filter: blur(12px);">
  <div class="container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem; text-align: center;">
    <div>
      <div style="font-family: 'Outfit', var(--font-body); font-size: 1.6rem; font-weight: 800; color: var(--color-text-primary);">0 Trackers</div>
      <div class="text-secondary" style="font-size: 0.8125rem;">Zero Ad Pixels or Telemetry Logs</div>
    </div>
    <div>
      <div style="font-family: 'Outfit', var(--font-body); font-size: 1.6rem; font-weight: 800; color: #4ade80;">100% TLS</div>
      <div class="text-secondary" style="font-size: 0.8125rem;">Encrypted IMAP 993 / SMTP 465</div>
    </div>
    <div>
      <div style="font-family: 'Outfit', var(--font-body); font-size: 1.6rem; font-weight: 800; color: #c084fc;">1-View Burn</div>
      <div class="text-secondary" style="font-size: 0.8125rem;">Zero-Click Ephemeral Incineration</div>
    </div>
    <div>
      <div style="font-family: 'Outfit', var(--font-body); font-size: 1.6rem; font-weight: 800; color: #60a5fa;">Multi-Account</div>
      <div class="text-secondary" style="font-size: 0.8125rem;">Gmail, Outlook, Yahoo & Custom IMAP</div>
    </div>
  </div>
</section>

<!-- ─── Three Types of Email Available (Account Tiers) ───────── -->
<section style="padding: 5rem 0;">
  <div class="container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 3rem;">
      <span class="badge badge-purple" style="margin-bottom: 0.75rem; padding: 0.3rem 0.85rem; font-size: 0.75rem;">Platform Versatility</span>
      <h2 style="font-family: 'Outfit', var(--font-body); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800; color: var(--color-text-primary); margin-bottom: 0.5rem; letter-spacing: -0.02em;">
        Three Types of Email. One Sovereign Suite.
      </h2>
      <p class="text-secondary" style="font-size: 0.9375rem;">
        Whether you need a 10-second spam shield, a 60-day project mailbox, or a permanent encrypted enclave identity, WoxMail provides the exact tier you need.
      </p>
    </div>

    <div class="tiers-grid">
      <!-- Tier 1: Public Temp Mail -->
      <div class="tier-card">
        <div class="tier-header">
          <div class="tier-icon" style="background: rgba(124, 58, 237, 0.15); color: #c084fc; display: flex; align-items: center; justify-content: center;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
          <h3 class="tier-title">Public Temp Mail</h3>
          <p class="tier-desc">
            Zero-friction disposable email for instant website signups, OTP verifications, and shielding your real inbox from spam.
          </p>
        </div>

        <ul class="tier-feature-list">
          <li class="tier-feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span><strong>Instant address</strong> generated in under 5ms</span>
          </li>
