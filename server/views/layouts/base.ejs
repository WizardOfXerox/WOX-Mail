  <main class="main">
    <%- body %>
  </main>

  <% if (typeof showFooter === 'undefined' || showFooter !== false) { %>
  <footer class="footer">
    <div class="container footer-inner">
      <p class="text-tertiary">&copy; <%= new Date().getFullYear() %> WoxMail. All rights reserved.</p>
      <div class="footer-links">
        <a href="/support" class="text-tertiary">Support</a>
        <a href="/docs" class="text-tertiary">API Docs</a>
        <a href="/privacy" class="text-tertiary">Privacy</a>
        <a href="/terms" class="text-tertiary">Terms</a>
      </div>
    </div>
  </footer>
  <% } %>

  <!-- Toast container -->
  <div id="toast-container" class="toast-container"></div>

  <!-- Core scripts (all pages) -->
  <script src="/js/theme.js"></script>
  <script src="/js/toast.js"></script>

  <script>
    // ── Nav scroll shadow ──
    (function() {
      var nav = document.getElementById('main-nav');
      if (nav) {
        window.addEventListener('scroll', function() {
          nav.classList.toggle('scrolled', window.scrollY > 8);
        }, { passive: true });
      }

      // ── Theme icon sync ──
      var sunSvg = '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
      var moonSvg = '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';

      function syncThemeIcon() {
        var btn = document.getElementById('theme-toggle-btn');
        var mobileIcon = document.getElementById('theme-mobile-icon');
        var theme = document.documentElement.getAttribute('data-theme');
        var iconHtml = theme === 'light' ? sunSvg : moonSvg;
        if (btn) btn.innerHTML = iconHtml;
        if (mobileIcon) mobileIcon.innerHTML = iconHtml;
      }
      syncThemeIcon();
      var obs = new MutationObserver(syncThemeIcon);
      obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    })();

    // ── Mobile menu ──
    var menuOpenSvg = '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
    var menuCloseSvg = '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>';

    function toggleMobileMenu() {
      var menu = document.getElementById('nav-mobile');
      var btn = document.getElementById('nav-hamburger');
      if (!menu) return;
      var isOpen = menu.classList.toggle('open');
      if (btn) {
        btn.innerHTML = isOpen ? menuOpenSvg : menuCloseSvg;
        btn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
      }
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    function closeMobileMenu() {
      var menu = document.getElementById('nav-mobile');
      var btn = document.getElementById('nav-hamburger');
      if (menu) menu.classList.remove('open');
      if (btn) {
        btn.innerHTML = menuCloseSvg;
        btn.setAttribute('aria-label', 'Open menu');
      }
      document.body.style.overflow = '';
    }

    // ── Global Theme & Shaders Modal ──
    function toggleGlobalThemeModal(e) {
      if (e) e.stopPropagation();
      var modal = document.getElementById('global-theme-backdrop');
      if (!modal) return;
      var isShown = modal.style.display === 'flex';
      if (isShown) {
        closeGlobalThemeModal();
      } else {
        openGlobalThemeModal();
      }
    }

    function openGlobalThemeModal() {
      var modal = document.getElementById('global-theme-backdrop');
      if (modal) {
        modal.style.display = 'flex';
        updateGlobalThemeModalUI();
      }
    }

    function closeGlobalThemeModal() {
      var modal = document.getElementById('global-theme-backdrop');
      if (modal) modal.style.display = 'none';
    }

    function updateGlobalThemeModalUI() {
      var theme = localStorage.getItem('woxmail_theme') || 'dark';
      var accent = localStorage.getItem('woxmail_accent') || 'purple';
      var bgMode = localStorage.getItem('woxmail_bg_mode') || 'aurora';
      var font = localStorage.getItem('woxmail_font') || 'inter';
      var isGlass = document.documentElement.getAttribute('data-glass') === 'true';
      var intensity = parseFloat(localStorage.getItem('woxmail_bg_intensity') || '1.0');

      // Theme mode buttons
      ['dark', 'light', 'system'].forEach(function(t) {
        var el = document.getElementById('gt-btn-' + t);
        if (el) el.classList.toggle('active', theme === t);
      });

      // Accent buttons
      ['purple', 'emerald', 'cobalt', 'amber', 'cyan', 'crimson', 'oled'].forEach(function(a) {
        var el = document.getElementById('gt-acc-' + a);
        if (el) el.classList.toggle('active', accent === a);
      });

      // Background shaders
      ['aurora', 'cyber_mesh', 'deep_space', 'matrix', 'zen_drift', 'particles'].forEach(function(m) {
        var el = document.getElementById('gt-bg-' + m);
        if (el) el.classList.toggle('active', bgMode === m);
      });

      // Glass button
      var glassBtn = document.getElementById('gt-btn-glass');
      if (glassBtn) {
        glassBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right:4px;"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg><span>Glassmorphism: ' + (isGlass ? 'ON' : 'OFF') + '</span>';
        glassBtn.style.background = isGlass ? 'var(--color-primary-glow)' : 'transparent';
      }

      // Fonts
      ['inter', 'mono', 'serif'].forEach(function(f) {
        var el = document.getElementById('gt-font-' + f);
        if (el) el.classList.toggle('active', font === f);
      });

      // Intensity slider
      var slider = document.getElementById('gt-intensity-slider');
      var valText = document.getElementById('gt-intensity-val');
      if (slider) slider.value = intensity;
      if (valText) valText.innerText = Math.round(intensity * 100) + '%';
    }

    function toggleGlassMode() {
      var isGlass = document.documentElement.getAttribute('data-glass') === 'true';
      var next = !isGlass;
      localStorage.setItem('woxmail_glass', String(next));
      if (next) {
        document.documentElement.setAttribute('data-glass', 'true');
      } else {
        document.documentElement.removeAttribute('data-glass');
      }
    }

    // ── User Profile & Account Switcher Dropdown ──
    function toggleUserDropdown(e) {
      if (e) e.stopPropagation();
      var menu = document.getElementById('nav-user-dropdown');
      if (!menu) return;
      var isShown = menu.style.display === 'block';
      menu.style.display = isShown ? 'none' : 'block';
      if (!isShown && window.WoxAccountManager) {
        window.WoxAccountManager.initNavDropdown();
      }
    }

    function closeUserDropdown() {
      var menu = document.getElementById('nav-user-dropdown');
      if (menu) menu.style.display = 'none';
    }

    document.addEventListener('click', function(e) {
      var wrap = document.querySelector('.nav-user-dropdown-wrap');
      if (wrap && !wrap.contains(e.target)) {
        closeUserDropdown();
      }
    });

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeMobileMenu();
        closeUserDropdown();
        closeGlobalThemeModal();
      }
      if ((e.key === 't' || e.key === 'T') && !['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName) && !e.target.isContentEditable && !e.ctrlKey && !e.metaKey) {
        var modal = document.getElementById('global-theme-backdrop');
        if (modal && !document.getElementById('dashboard-root')) {
          e.preventDefault();
          toggleGlobalThemeModal();
        }
      }
    });

    async function handleSignOut() {
      try {
        await fetch('/api/auth/logout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include'
        });
      } catch (err) {}
      window.location.href = '/login';
    }
  </script>

  <!-- Floating PWA Install Banner (For Mobile & Desktop) -->
  <div id="wox-pwa-banner" class="wox-pwa-banner">
    <div class="pwa-banner-content">
      <img src="/assets/icon-192.png" alt="WoxMail" class="pwa-banner-icon">
      <div class="pwa-banner-text">
        <div class="pwa-banner-title">Install WoxMail Web App</div>
        <div class="pwa-banner-subtitle">Standalone desktop & mobile app with offline speed.</div>
      </div>
    </div>
    <div class="pwa-banner-actions">
      <button type="button" class="btn btn-primary btn-sm" onclick="triggerPWAInstall()">Install</button>
      <button type="button" class="btn btn-ghost btn-sm" onclick="dismissPWABanner()" aria-label="Dismiss" style="color: #a1a1aa; padding: 0.25rem 0.5rem; display: inline-flex; align-items: center; justify-content: center;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <script src="/js/account-manager.js"></script>
  <% if (typeof user !== 'undefined' && user) { %>
  <script>
    if (window.WoxAccountManager) {
      window.WoxAccountManager.syncCurrentSession({
        id: <%= user.id %>,
        email: '<%= user.email || user.username + "@wox.world" %>',
        username: '<%= user.username %>',
        displayName: '<%= user.display_name || user.username %>',
        is_admin: <%= user.is_admin ? 'true' : 'false' %>
      });
    }
  </script>
  <% } %>
  <script src="/js/pwa.js"></script>
  <script src="/js/backgrounds.js" defer></script>
  <%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
</html>
