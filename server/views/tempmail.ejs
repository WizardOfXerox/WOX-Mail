<%- include('layouts/base', { title: 'Temp Mail — Disposable Email Address', body: `

<div class="tempmail-wrapper">
  <div class="container tempmail-container">
    
    <!-- Top Header -->
    <div class="tempmail-header-block text-center" style="margin-bottom: 1.25rem;">
      <div style="display: flex; gap: 0.4rem; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 0.4rem;">
        <div class="status-pill" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">
          <span class="pulse-dot"></span>
          <span>SSE Sync • <strong class="text-purple">@mail.wox.world</strong></span>
        </div>
        <div class="status-pill" style="border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.1); color: var(--color-error); font-size: 0.75rem; padding: 0.25rem 0.65rem;" title="Continuous executor cleaner sweeps expired public mailboxes">
          <span class="pulse-dot" style="background: var(--color-error);"></span>
          <span>Purge Cycle: <strong id="next-purge-timer" class="mono" style="font-weight: 700;">14:59</strong></span>
        </div>
      </div>
      <h1 class="tempmail-title" style="font-size: clamp(1.6rem, 5vw, 2.25rem); margin-bottom: 0.25rem; font-weight: 800;">Instant Disposable Email</h1>
      <p class="tempmail-subtitle text-secondary" style="font-size: clamp(0.85rem, 2vw, 0.95rem); margin: 0 auto; max-width: 540px;">
        Zero signup required. Use this temporary address anywhere to protect your privacy from spam and trackers.
      </p>
    </div>

    <!-- Main Mailbox Hub Card -->
    <div class="card mailbox-card">
      <div class="mailbox-card-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; flex-wrap: wrap; gap: 0.4rem;">
        <div class="mailbox-header-left" style="display: flex; align-items: center; gap: 0.4rem;">
          <span class="mailbox-label" style="font-weight: 700; font-size: 0.9375rem; display: flex; align-items: center; gap: 0.35rem;">
            <svg class="icon-svg text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Your Temporary Address
          </span>
          <span class="badge badge-purple" id="status-badge">Active</span>
        </div>
        <div class="mailbox-header-right">
          <span class="countdown-badge" id="countdown-text" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Loading...
          </span>
        </div>
      </div>

      <!-- Address Display & Action Toolbar -->
      <div class="address-box-wrapper" style="margin-bottom: 0.85rem;">
        <div class="address-input-group">
          <svg class="address-icon text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <input type="text" id="address-text-input" class="address-input-field mono" value="Generating address..." readonly />
        </div>
        <div class="address-actions-grid">
          <button type="button" class="btn btn-primary" id="copy-address-btn" onclick="copyAddress()" title="Copy email address (Key: C)">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span>Copy</span>
          </button>
          <button type="button" class="btn btn-secondary" onclick="generateAddress(true)" id="refresh-address-btn" title="Generate fresh address (Key: N)">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
            <span>New</span>
          </button>
          <select id="temp-domain-select" class="btn btn-secondary" style="padding: 0.4rem 0.6rem; font-size: 0.8125rem; font-family: var(--font-mono); cursor: pointer;" onchange="changeDomain(this.value)" title="Choose domain">
            <option value="mail.wox.world">@mail.wox.world</option>
            <option value="wox.world">@wox.world</option>
          </select>
          <button type="button" class="btn btn-secondary" onclick="promptCustomAddress()" title="Choose a custom username prefix">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            <span>Custom</span>
          </button>
          <button type="button" class="btn btn-secondary" onclick="showQR()" title="View QR code for mobile scanning">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
            <span>QR</span>
          </button>
          <button type="button" class="btn btn-ghost text-secondary" onclick="deleteMailbox()" title="Delete and purge this mailbox immediately">
            <svg class="icon-svg text-error" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
            <span>Delete</span>
          </button>
        </div>
      </div>

      <!-- Duration Selector Tabs -->
      <div class="duration-selector-bar">
        <span class="duration-label text-secondary">Duration:</span>
        <div class="duration-pills">
          <button type="button" class="duration-btn expiry-btn" data-hours="1" onclick="selectDuration(1)">1 Hour</button>
          <button type="button" class="duration-btn expiry-btn" data-hours="6" onclick="selectDuration(6)">6 Hours</button>
          <button type="button" class="duration-btn expiry-btn active" data-hours="24" onclick="selectDuration(24)">24 Hours</button>
          <button type="button" class="duration-btn expiry-btn" data-hours="72" onclick="selectDuration(72)">3 Days</button>
        </div>
      </div>
    </div>

    <!-- Live Incoming Messages Card -->
    <div class="card inbox-card">
      <div class="inbox-card-header">
        <div class="inbox-title-group">
          <h2>
            <svg class="icon-svg text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            Incoming Messages
          </h2>
          <span class="badge badge-purple" id="message-count">0 messages</span>
        </div>

        <!-- Live Search Filter Input -->
        <div class="inbox-search-wrap">
          <svg class="inbox-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" id="inbox-search-input" class="inbox-search-field" placeholder="Filter emails... (Press / to search)" oninput="filterMessages(this.value)" />
        </div>

        <div class="inbox-header-actions">
          <button type="button" class="btn btn-ghost btn-sm" id="sound-toggle-btn" onclick="toggleSoundNotifications()" title="Toggle audio chime notification">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          </button>
          <button type="button" class="btn btn-secondary btn-sm" id="manual-refresh-btn" onclick="refreshInbox(true)" title="Check for new incoming messages (Key: R)">
            <svg id="refresh-spinner-icon" class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
            <span>Refresh</span>
          </button>
          <span class="live-indicator"><span class="pulse-dot"></span> Auto-sync (30s)</span>
        </div>
      </div>

      <!-- Messages Stream Container -->
      <div id="message-list" class="message-stream">
        <div class="empty-inbox-state" id="empty-state">
          <div class="radar-box">
            <span class="radar-wave"></span>
            <svg class="radar-icon-svg text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/></svg>
          </div>
          <h3>Waiting for incoming emails...</h3>
          <p class="text-secondary">
            Send an email or verification code to <strong class="mono text-purple" id="empty-address-hint">your address</strong> above and it will appear here automatically in real-time.
          </p>
        </div>
      </div>

      <!-- In-Page Message Viewer -->
      <div id="message-viewer" class="message-viewer" style="display:none;">
        <div class="viewer-nav">
          <button type="button" class="btn btn-secondary btn-sm" onclick="closeViewer()" title="Return to message list (Key: Esc)">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <span>Back to Inbox</span>
          </button>
          <div class="viewer-actions">
            <button type="button" class="btn btn-ghost btn-sm" onclick="copyMessageBody()" title="Copy email text content (Key: C)">
              <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span>Copy Content</span>
            </button>
            <button type="button" class="btn btn-ghost btn-sm" onclick="printEmail()" title="Print this email">
              <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
              <span>Print</span>
            </button>
            <button type="button" class="btn btn-ghost btn-sm" onclick="downloadEml()" title="Download raw .eml file">
              <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              <span>Download .eml</span>
            </button>
            <button type="button" class="btn btn-ghost btn-sm" onclick="viewSource()" title="View full RFC822 headers and source">
              <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              <span>Source</span>
            </button>
          </div>
        </div>
        <div class="viewer-header-info">
          <h2 id="viewer-subject" class="viewer-subject-title"></h2>
          <div class="viewer-sender-line text-secondary">
            <span>From: <strong id="viewer-from" class="text-primary"></strong></span>
            <span>•</span>
            <span id="viewer-date"></span>
          </div>
        </div>
        <div id="viewer-otp-banner"></div>
        <div id="viewer-body" class="viewer-content-box"></div>
      </div>

      <!-- Keyboard Shortcuts Quick Helper Bar -->
      <div class="keyboard-shortcuts-bar">
        <span class="text-secondary font-medium">Keyboard Shortcuts:</span>
        <span class="shortcut-chip"><kbd>J</kbd>/<kbd>K</kbd> Navigate</span>
        <span class="shortcut-chip"><kbd>Enter</kbd> Open</span>
        <span class="shortcut-chip"><kbd>Esc</kbd> Back</span>
        <span class="shortcut-chip"><kbd>R</kbd> Refresh</span>
        <span class="shortcut-chip"><kbd>N</kbd> New</span>
        <span class="shortcut-chip"><kbd>C</kbd> Copy</span>
        <span class="shortcut-chip"><kbd>/</kbd> Filter</span>
      </div>
    </div>

    <!-- Community Recent Public Directory Card -->
    <div class="card recent-directory-card">
      <div class="recent-card-header">
        <div>
          <h3>
            <svg class="icon-svg text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
            Public Temp Mail Directory
          </h3>
          <p class="text-secondary" style="font-size: 0.875rem;">Recently active community disposable addresses.</p>
        </div>
        <div style="display:flex;gap:0.5rem;align-items:center;">
          <button type="button" class="btn btn-ghost btn-sm" id="recent-refresh-btn" onclick="refreshAll()" title="Refresh recent list & inboxes">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
            <span>Refresh List</span>
          </button>
        </div>
      </div>
      <div id="recent-list" class="recent-grid-list">
        <div class="empty-state text-secondary" id="recent-empty" style="padding: 1.5rem; text-align: center;">
          Loading recent addresses...
        </div>
      </div>
    </div>

    <!-- Upgrade to Personal Temp Mail Banner -->
    <div class="upgrade-banner card">
      <div class="upgrade-info">
        <div class="upgrade-icon-wrap">
          <svg class="upgrade-icon-svg text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div>
          <h4>Need a custom username or password protection?</h4>
          <p class="text-secondary">Create a <strong>Personal Temp Mail</strong> — lasts up to 60 days with message search, star, and forwarding.</p>
        </div>
      </div>
      <a href="/tempmail/personal" class="btn btn-secondary">
        <span>Create Personal Temp Mail</span>
        <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</div>

<!-- QR Code Modal -->
<div id="qr-modal" class="modal-overlay" style="display:none;" onclick="if(event.target===this)closeQR()">
  <div class="card modal-card text-center qr-modal-card">
    <div class="qr-modal-header">
      <div class="qr-icon-pill">
        <svg class="icon-svg text-purple" style="width:24px;height:24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
      </div>
      <h3 class="qr-modal-title">Mobile Transfer</h3>
      <p class="text-secondary qr-modal-desc">Scan with your phone camera to open and sync this mailbox on mobile.</p>
    </div>
    
    <div class="qr-container">
      <img id="qr-image" class="qr-code-img" alt="QR Code" />
    </div>

    <div class="qr-address-pill">
      <span class="mono text-purple truncate" id="qr-address"></span>
      <button type="button" class="btn btn-ghost btn-xs" onclick="copyAddress()" title="Copy Address">
        <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        <span>Copy</span>
      </button>
    </div>

    <div class="qr-modal-actions" style="display:flex;gap:0.5rem;justify-content:center;margin-top:1.25rem;">
      <button type="button" class="btn btn-secondary btn-sm" onclick="saveQrImage()" title="Download QR code image">
        <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        <span>Save QR</span>
      </button>
      <button type="button" class="btn btn-secondary btn-sm" onclick="shareInboxUrl()" title="Share mailbox link">
        <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
        <span>Share</span>
      </button>
      <button type="button" class="btn btn-ghost btn-sm" onclick="closeQR()">Close</button>
    </div>
  </div>
</div>

`, scripts: '<script src="/js/tempmail.js?v=4.0"></script>' }) %>

<style>
  .tempmail-wrapper {
    padding: 3rem 0 5rem;
    min-height: calc(100vh - var(--nav-height) - 100px);
  }
  .tempmail-container {
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Header Block */
  .tempmail-header-block {
    max-width: 680px;
    margin: 0 auto 0.5rem;
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.35rem 1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
  }
  .tempmail-title {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }
  .tempmail-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* Mailbox Card */
  .mailbox-card {
    padding: 1.75rem 2rem;
    border: 1px solid var(--color-primary-light);
    box-shadow: 0 0 35px var(--color-primary-glow);
    background: var(--color-bg-card);
    border-radius: var(--radius-xl);
  }
  .mailbox-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .mailbox-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mailbox-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .countdown-badge {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--color-warning);
    background: rgba(245, 158, 11, 0.12);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
  }

  /* Address Box */
  .address-box-wrapper {
    display: flex;
    gap: 0.875rem;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .address-input-group {
    flex: 1;
    min-width: 280px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-bg-input);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 0.75rem 1.25rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .address-input-group:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-glow);
  }
  .address-icon {
    font-size: 1.35rem;
  }
  .address-input-field {
    width: 100%;
    border: none;
    background: transparent;
    color: var(--color-text-primary);
    font-size: 1.15rem;
    font-weight: 700;
    outline: none;
    letter-spacing: -0.01em;
  }
  .address-actions-grid {
