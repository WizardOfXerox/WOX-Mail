<%- include('layouts/base', { title: 'Dashboard', showNav: false, showFooter: false, body: `
<div id="dashboard-root">
  <!-- React mounts here -->
  <div class="dashboard-loading">
    <div class="skeleton-dashboard">
      <div class="skeleton-sidebar">
        <div class="skeleton skeleton-text" style="width:60%;height:1.5rem;margin-bottom:1.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:80%;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:70%;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:75%;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:65%;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:50%;margin-bottom:1.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:80%;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:60%;margin-bottom:0.5rem;"></div>
      </div>
      <div class="skeleton-main">
        <div class="skeleton skeleton-text" style="width:40%;height:2rem;margin-bottom:1rem;"></div>
        <div class="skeleton skeleton-text" style="width:100%;height:3.5rem;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:100%;height:3.5rem;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:100%;height:3.5rem;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:100%;height:3.5rem;margin-bottom:0.5rem;"></div>
        <div class="skeleton skeleton-text" style="width:100%;height:3.5rem;margin-bottom:0.5rem;"></div>
      </div>
    </div>
  </div>
</div>
`, scripts: '<script type="module" src="/dist/dashboard.js"></script>' }) %>

<style>
  body { overflow: hidden; }
  #dashboard-root { height: 100vh; }
  .dashboard-loading { height: 100vh; display: flex; }
  .skeleton-dashboard { display: flex; width: 100%; height: 100%; }
  .skeleton-sidebar { width: 240px; padding: 1.5rem; border-right: 1px solid var(--color-border); background: var(--color-bg-card); flex-shrink: 0; }
  .skeleton-main { flex: 1; padding: 1.5rem; }
  @media (max-width: 768px) { .skeleton-sidebar { display: none; } }
</style>
