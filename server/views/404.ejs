<%- include('layouts/base', { title: '404 — Not Found', body: `
<div class="error-page">
  <div class="error-content">
    <span class="error-code">404</span>
    <h1>Page not found</h1>
    <p class="text-secondary">The page you're looking for doesn't exist or has been moved.</p>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">Go Home</a>
      <a href="/tempmail" class="btn btn-secondary">Temp Mail</a>
    </div>
  </div>
</div>
` }) %>

<style>
  .error-page { min-height: 80vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 2rem; }
  .error-code { font-size: 6rem; font-weight: 800; color: var(--color-primary); line-height: 1; display: block; margin-bottom: 1rem; }
  .error-content h1 { margin-bottom: 0.75rem; }
  .error-content p { margin-bottom: 2rem; }
  .error-actions { display: flex; gap: 1rem; justify-content: center; }
</style>
