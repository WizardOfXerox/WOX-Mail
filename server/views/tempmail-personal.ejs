<%- include('layouts/base', { title: 'Personal Temp Mail', body: `

<div class="container tempmail-page">
  <!-- Register / Create -->
  <div id="personal-create">
    <div class="tempmail-hero">
      <div class="status-pill" style="margin-bottom: 1rem;">
        <span class="pulse-dot"></span>
        <span>Password Protected • Up to 60 Days Lifetime</span>
      </div>
      <h1 class="tempmail-title">Personal Temp Mail</h1>
      <p class="text-secondary" style="max-width: 540px; margin: 0 auto 2rem;">Choose your custom username, protect it with a password, and manage your disposable inbox across multiple sessions.</p>

      <form id="create-form" class="auth-form card" style="max-width:460px;margin:0 auto;text-align:left;">
        <div class="form-group">
          <label class="form-label">Username (leave blank for random)</label>
          <div class="input-with-suffix">
            <input type="text" id="custom-username" class="input mono" placeholder="myname" minlength="3" maxlength="30">
            <span class="input-suffix mono text-purple">@mail.wox.world</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Password (to log in again anytime)</label>
          <input type="password" id="personal-password" class="input" placeholder="Min 6 characters" required minlength="6">
        </div>

        <div class="form-group">
          <label class="form-label">Duration / Lifetime</label>
          <select id="personal-expiry" class="input">
            <option value="24">1 Day (24 Hours)</option>
            <option value="168">1 Week (7 Days)</option>
            <option value="720" selected>30 Days</option>
            <option value="1440">60 Days</option>
          </select>
        </div>

        <div id="captcha-container" class="captcha-container"></div>

        <button type="submit" class="btn btn-primary btn-lg btn-full" id="create-btn">
          <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Create Personal Inbox</span>
        </button>
      </form>

      <div class="auth-links" style="margin-top: 2rem;">
        <p class="text-secondary">Already have a personal mailbox? <a href="/tempmail/login" class="text-purple font-medium">Sign in here →</a></p>
        <p class="text-tertiary" style="margin-top:0.5rem;">Or use <a href="/tempmail">Public Instant Temp Mail</a> (zero password needed)</p>
      </div>
    </div>
  </div>

  <!-- Active inbox -->
  <div id="personal-inbox" style="display:none;">
    <div class="card inbox-header-card" style="margin-bottom: 1.5rem;">
      <div class="inbox-header-top">
        <div class="address-display">
          <svg class="icon-svg text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span id="address-text" class="mono address-text"></span>
          <button class="btn btn-ghost btn-sm" onclick="copyAddress()" title="Copy Address">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          </button>
        </div>
        <div class="inbox-meta">
          <span class="badge badge-purple" id="status-badge">Personal</span>
          <span class="countdown-badge" id="countdown-text" style="display:inline-flex; align-items:center; gap:0.35rem;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Loading...</span>
          </span>
          <button class="btn btn-secondary btn-sm" onclick="extendExpiry()">
            <svg class="icon-svg" style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Extend</span>
          </button>
          <button class="btn btn-ghost btn-sm" onclick="logout()" title="Switch or Create Another Mailbox" style="font-size:0.75rem; display:inline-flex; align-items:center; gap:0.35rem;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>
            <span>Switch</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Search + Controls -->
    <div class="inbox-controls card" style="margin-bottom: 1.25rem;">
      <div class="inbox-search-wrap" style="flex:1;">
        <svg class="inbox-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="search-input" class="inbox-search-field input" placeholder="Search by sender or subject...">
      </div>
      <div class="inbox-sort">
        <select id="sort-select" class="input" style="width:auto;padding:0.4rem 0.75rem;">
          <option value="date-desc">Newest first</option>
          <option value="date-asc">Oldest first</option>
          <option value="from">By sender</option>
        </select>
        <label class="checkbox-label">
          <input type="checkbox" id="unread-filter"> Unread only
        </label>
      </div>
    </div>

    <!-- Batch actions -->
    <div id="batch-bar" class="batch-bar" style="display:none;">
      <label class="checkbox-label">
        <input type="checkbox" id="select-all" onchange="toggleSelectAll()"> Select all
      </label>
      <button class="btn btn-danger btn-sm" onclick="batchDelete()">
        <svg class="icon-svg" style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
        <span>Delete selected</span>
      </button>
    </div>

    <!-- Message list -->
    <div class="card inbox-card" style="margin-bottom: 1.5rem;">
      <div id="message-list" class="message-stream">
        <div class="empty-inbox-state" id="empty-state">
          <div class="radar-box">
            <span class="radar-wave"></span>
            <svg class="radar-icon-svg text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/></svg>
          </div>
          <h3>Waiting for incoming emails...</h3>
          <p class="text-secondary">Emails sent to your personal address will appear here automatically in real-time.</p>
        </div>
      </div>

      <!-- Pagination -->
      <div id="pagination" class="pagination" style="display:none;padding-top:1rem;border-top:1px solid var(--color-border);">
        <button class="btn btn-ghost btn-sm" id="prev-page" onclick="prevPage()">← Prev</button>
        <span id="page-info" class="text-secondary font-mono"></span>
        <button class="btn btn-ghost btn-sm" id="next-page" onclick="nextPage()">Next →</button>
      </div>

      <!-- Message viewer -->
      <div id="message-viewer" class="message-viewer" style="display:none;">
        <div class="viewer-nav">
          <button class="btn btn-secondary btn-sm" onclick="closeViewer()">
            <svg class="icon-svg" style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <span>Back to Inbox</span>
          </button>
          <div class="viewer-actions">
            <button class="btn btn-ghost btn-sm" onclick="toggleStar()" title="Star email">⭐ Star</button>
            <button class="btn btn-ghost btn-sm" onclick="downloadEml()" title="Download .eml">.eml</button>
            <button class="btn btn-ghost btn-sm" onclick="viewSource()" title="View Source">Source</button>
          </div>
        </div>
        <div class="viewer-header-info">
          <h2 id="viewer-subject" class="viewer-subject-title"></h2>
          <div class="viewer-sender-line text-secondary">
            <span>From: <strong id="viewer-from" class="text-primary"></strong></span>
            <span>•</span>
            <span id="viewer-date"></span>
          </div>
          <div id="viewer-badges" class="viewer-badges" style="margin-top:0.5rem;"></div>
        </div>
        <div id="viewer-body" class="viewer-content-box"></div>
        <div id="viewer-attachments" class="viewer-attachments" style="margin-top: 1rem;"></div>
      </div>
    </div>

    <div class="inbox-actions">
      <button class="btn btn-secondary btn-sm" onclick="logout()">
        <svg class="icon-svg" style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
        <span>Logout</span>
      </button>
      <button class="btn btn-ghost text-error btn-sm" onclick="deleteMailbox()">
        <svg class="icon-svg" style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
        <span>Delete Mailbox</span>
      </button>
    </div>
  </div>
</div>

`, scripts: '<script src="/js/tempmail-personal.js"></script>' }) %>

<style>
  .tempmail-page { max-width: 860px; padding: 3rem 1.5rem 5rem; }
  .tempmail-hero { text-align: center; padding: 1.5rem 0; }
  .tempmail-title { font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 800; color: #ffffff !important; margin-bottom: 0.75rem; font-family: 'Outfit', var(--font-body); letter-spacing: -0.02em; }
  [data-theme='light'] .tempmail-title { color: #1a1a2e !important; }
  .auth-form { padding: 2rem; border-radius: var(--radius-xl); }
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; text-align: left; margin-bottom: 1.25rem; }
  .form-label { font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); }
  .btn-full { width: 100%; justify-content: center; }
  .input-with-suffix { position: relative; }
  .input-with-suffix .input { padding-right: 9.5rem; }
  .input-suffix { position: absolute; right: 0.875rem; top: 50%; transform: translateY(-50%); font-size: 0.8125rem; pointer-events: none; }

  .inbox-header-top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .address-display { display: flex; align-items: center; gap: 0.75rem; }
  .address-text { font-size: 1.25rem; font-weight: 700; color: var(--color-primary-light); }
  .inbox-meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .inbox-controls { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.5rem; border-radius: var(--radius-lg); flex-wrap: wrap; }
  .inbox-search-wrap { position: relative; display: flex; align-items: center; width: 100%; }
  .inbox-search-icon { position: absolute; left: 0.85rem; width: 16px; height: 16px; max-width: 16px; max-height: 16px; color: var(--color-text-tertiary); pointer-events: none; }
  .inbox-search-field { width: 100%; padding-left: 2.35rem !important; }
  .inbox-sort { display: flex; gap: 0.75rem; align-items: center; }
  .checkbox-label { display: flex; align-items: center; gap: 0.375rem; font-size: 0.875rem; color: var(--color-text-secondary); cursor: pointer; }

  .batch-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 1.25rem; background: var(--color-bg-elevated); border: 1px solid var(--color-border); border-radius: var(--radius-md); margin-bottom: 1rem; }

  .pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; }
  .viewer-content-box { background: #ffffff; color: #1a1a2e; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: var(--radius-lg); padding: 1.5rem; min-height: 260px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25); }

  .inbox-actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; }
</style>

