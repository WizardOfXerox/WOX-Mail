{
  "manifest_version": 3,
  "name": "WoxCrypt — Sovereign PGP & Disposable Mail Companion",
  "version": "1.0.0",
  "description": "Hardware-enclave grade OpenPGP key vault and 1-click disposable temp-mail autofill for any website.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/openpgp.min.js", "content/contentScript.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.wox.world/*",
    "https://mail.wox.world/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ]
}
