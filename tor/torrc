# ==============================================================================
# WoxMail Tor Hidden Service Configuration (torrc)
# Routes darknet .onion HTTP port 80 requests directly to WoxMail port 3001
# ==============================================================================

DataDirectory H:/Ideas/Mail/tor/data
GeoIPFile H:/Ideas/Mail/tor/data/geoip
GeoIPv6File H:/Ideas/Mail/tor/data/geoip6

# Local SOCKS5 Proxy
SocksPort 9050

# WoxMail V3 Onion Hidden Service
HiddenServiceDir H:/Ideas/Mail/tor/hidden_service
HiddenServicePort 80 127.0.0.1:3001
