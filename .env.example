# ==============================================
# WoxMail Environment Configuration
# ==============================================

# Server Environment & Port
NODE_ENV=development
PORT=3001

# Database & Redis Connection
DATABASE_URL=postgresql://woxmail:woxmail@localhost:5432/woxmail
REDIS_URL=redis://localhost:6379

# Session & Authentication Secrets
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Purelymail API & Mail Protocols
PURELYMAIL_API_TOKEN=your-purelymail-api-token
PURELYMAIL_IMAP_HOST=imap.purelymail.com
PURELYMAIL_IMAP_PORT=993
PURELYMAIL_SMTP_HOST=smtp.purelymail.com
PURELYMAIL_SMTP_PORT=465

# hCaptcha Configuration
HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Domains
DOMAIN_PERMANENT=wox.world
DOMAIN_TEMP=mail.wox.world

# Admin Credentials
ADMIN_EMAIL=admin@wox.world
ADMIN_PASSWORD=change-this-admin-password

# Web Push (VAPID) Keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@mail.wox.world

# Temp Account Pool Sizing
POOL_TARGET_SIZE=20
POOL_MIN_SIZE=5

# Expiry Settings
TEMP_PUBLIC_MAX_EXPIRY_HOURS=72
TEMP_PERSONAL_MAX_EXPIRY_DAYS=60

# Base URL (for links in emails and webhooks)
BASE_URL=https://mail.wox.world

# Database Backups
BACKUP_DIR=./backups
MAX_BACKUPS=7
BACKUP_SCHEDULE=0 4 * * *

# TextBee SMS Gateway (Phase 3 — optional)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
